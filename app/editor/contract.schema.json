    },
    "HistoryRestoreRequest": {
      "$ref": "#/$defs/HistoryRestoreRequest"
    },
    "HistoryRestoreResponse": {
      "$ref": "#/$defs/HistoryRestoreResponse"
    },
    "ImageInfo": {
      "$ref": "#/$defs/ImageInfo"
    },
    "ImageInfoRequest": {
      "$ref": "#/$defs/ImageInfoRequest"
    },
    "ImageMissing": {
      "$ref": "#/$defs/ImageMissing"
    },
    "ImportDone": {
      "$ref": "#/$defs/ImportDone"
    },
    "ImportPreview": {
      "$ref": "#/$defs/ImportPreview"
    },
    "ImportRequest": {
      "$ref": "#/$defs/ImportRequest"
    },
    "ImportSummary": {
      "$ref": "#/$defs/ImportSummary"
    },
    "KeyShortcutPlace": {
      "$ref": "#/$defs/KeyShortcutPlace"
    },
    "LogDetail": {
      "$ref": "#/$defs/LogDetail"
    },
    "LogFiles": {
      "$ref": "#/$defs/LogFiles"
    },
    "LogRecord": {
      "$ref": "#/$defs/LogRecord"
    },
    "LogSummary": {
      "$ref": "#/$defs/LogSummary"
    },
    "LogsBadge": {
      "$ref": "#/$defs/LogsBadge"
    },
    "LogsQuery": {
      "$ref": "#/$defs/LogsQuery"
    },
    "LogsResponse": {
      "$ref": "#/$defs/LogsResponse"
    },
    "LogsSeenRequest": {
      "$ref": "#/$defs/LogsSeenRequest"
    },
    "ObsLists": {
      "$ref": "#/$defs/ObsLists"
    },
    "ObsOffline": {
      "$ref": "#/$defs/ObsOffline"
    },
    "Ok": {
      "$ref": "#/$defs/Ok"
    },
    "OpenRequest": {
      "$ref": "#/$defs/OpenRequest"
    },
    "PluginGroup": {
      "$ref": "#/$defs/PluginGroup"
    },
    "PluginInspect": {
      "$ref": "#/$defs/PluginInspect"
    },
    "PluginInstalled": {
      "$ref": "#/$defs/PluginInstalled"
    },
    "PluginLoadError": {
      "$ref": "#/$defs/PluginLoadError"
    },
    "PluginManifestSummary": {
      "$ref": "#/$defs/PluginManifestSummary"
    },
    "PluginRemoveRequest": {
      "$ref": "#/$defs/PluginRemoveRequest"
    },
    "PluginRemoved": {
      "$ref": "#/$defs/PluginRemoved"
    },
    "PluginShortcutPlace": {
      "$ref": "#/$defs/PluginShortcutPlace"
    },
    "PluginStatus": {
      "$ref": "#/$defs/PluginStatus"
    },
    "PluginZipRequest": {
      "$ref": "#/$defs/PluginZipRequest"
    },
    "PressRequest": {
      "$ref": "#/$defs/PressRequest"
    },
    "PreviewCells": {
      "$ref": "#/$defs/PreviewCells"
    },
    "PreviewRequest": {
      "$ref": "#/$defs/PreviewRequest"
    },
    "PreviewResponse": {
      "$ref": "#/$defs/PreviewResponse"
    },
    "PreviewSingle": {
      "$ref": "#/$defs/PreviewSingle"
    },
    "Problem": {
      "$ref": "#/$defs/Problem"
    },
    "RecordArm": {
      "$ref": "#/$defs/RecordArm"
    },
    "RecordCancel": {
      "$ref": "#/$defs/RecordCancel"
    },
    "RecordSent": {
      "$ref": "#/$defs/RecordSent"
    },
    "RecordState": {
      "$ref": "#/$defs/RecordState"
    },
    "SaveConfigRequest": {
      "$ref": "#/$defs/SaveConfigRequest"
    },
    "SendComboRequest": {
      "$ref": "#/$defs/SendComboRequest"
    },
    "ShortcutConflict": {
      "$ref": "#/$defs/ShortcutConflict"
    },
    "ShowRequest": {
      "$ref": "#/$defs/ShowRequest"
    },
    "StatusOffline": {
      "$ref": "#/$defs/StatusOffline"
    },
    "StatusOnline": {
      "$ref": "#/$defs/StatusOnline"
    },
    "UploadRequest": {
      "$ref": "#/$defs/UploadRequest"
    },
    "UploadResponse": {
      "$ref": "#/$defs/UploadResponse"
    },
    "ValidateErrors": {
      "$ref": "#/$defs/ValidateErrors"
    },
    "ValidateOk": {
      "$ref": "#/$defs/ValidateOk"
    },
    "ValidateRequest": {
      "$ref": "#/$defs/ValidateRequest"
    },
    "ValuesResponse": {
      "$ref": "#/$defs/ValuesResponse"
    },
    "WidgetCategory": {
      "$ref": "#/$defs/WidgetCategory"
    },
    "WidgetExpandRequest": {
      "$ref": "#/$defs/WidgetExpandRequest"
    },
    "WidgetExpanded": {
      "$ref": "#/$defs/WidgetExpanded"
    }
