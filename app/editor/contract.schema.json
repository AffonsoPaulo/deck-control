  "$defs": {
    "About": {
      "type": "object",
      "properties": {
        "firmware": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "type": "boolean"
        },
        "autostart": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "type": "string"
        },
        "log": {
          "type": "string"
        }
      },
      "required": [
        "firmware",
        "device",
        "autostart",
        "config",
        "log"
      ],
      "additionalProperties": false
    },
    "AutostartRequest": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "AutostartResponse": {
      "type": "object",
      "properties": {
        "autostart": {
          "type": "boolean"
        }
      },
      "required": [
        "autostart"
      ],
      "additionalProperties": false
    },
    "ConfigResponse": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": {}
        },
        "file": {
          "type": "string"
        }
      },
      "required": [
        "config",
        "file"
      ],
      "additionalProperties": false
    },
    "EditorSchema": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "icon_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "field_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "segoe_to_lucide": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "plugin_groups": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PluginGroup"
          }
        },
        "plugin_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginLoadError"
          }
        },
        "default_language": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "widgets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "widget_categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WidgetCategory"
          }
        },
        "value_ops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actions",
        "icon_fields",
        "field_labels",
        "segoe_to_lucide",
        "plugins",
        "plugin_groups",
        "plugin_errors",
        "default_language",
        "values",
        "widgets",
        "widget_categories",
        "value_ops"
      ],
      "additionalProperties": false,
      "description": "Tudo que o editor precisa para montar os formulários. As descrições de ações, campos, widgets e plugins ficam abertas: vêm também dos plugins."
    },
    "Empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false,
      "description": "Pedido sem campos (o editor manda {})."
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "code": {
          "const": "token"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "description": "Corpo de toda resposta que não é 200 (403 token/Host, 404, 400, 413, 500)."
    },
    "Errors": {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ok",
        "errors"
      ],
      "additionalProperties": false,
      "description": "O config tem problemas: nada foi gravado. Cada item é uma mensagem para a pessoa."
    },
    "ExportRequest": {
      "type": "object",
      "properties": {
        "include_secrets": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "FileDownload": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "data": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "data"
      ],
      "additionalProperties": false,
      "description": "Arquivo para baixar: nome e conteúdo em base64."
    },
    "FreeBindRequest": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": {}
        },
        "count": {
          "type": "integer"
        },
        "rules": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "taken": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "FreeBindResponse": {
      "type": "object",
      "properties": {
        "combos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "combos"
      ],
      "additionalProperties": false
    },
    "HistoryEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "time": {
          "type": "number"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "time",
        "reason",
        "summary"
      ],
      "additionalProperties": false
    },
    "HistoryResponse": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    },
    "HistoryRestoreRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "HistoryRestoreResponse": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": {}
        },
        "when": {
          "type": "string"
        }
      },
      "required": [
        "config",
        "when"
      ],
      "additionalProperties": false
    },
    "ImageInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "frames": {
          "type": "integer"
        },
        "thumb": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "width",
        "height",
        "frames",
        "thumb"
      ],
      "additionalProperties": false
    },
    "ImageInfoRequest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "ImageMissing": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "missing": {
          "const": true
        }
      },
      "required": [
        "name",
        "missing"
      ],
      "additionalProperties": false
    },
    "ImportDone": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "config": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "ok",
        "config"
      ],
      "additionalProperties": false
    },
    "ImportPreview": {
      "type": "object",
      "properties": {
        "summary": {
          "$ref": "#/$defs/ImportSummary"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "ImportRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "replace",
            "merge"
          ]
        }
      },
      "required": [
        "data"
      ],
      "additionalProperties": false
    },
    "ImportSummary": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keys": {
          "type": "integer"
        },
        "images": {
          "type": "integer"
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "pages",
        "keys",
        "images",
        "settings"
      ],
      "additionalProperties": false
    },
    "KeyShortcutPlace": {
      "type": "object",
      "properties": {
        "page": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "page",
        "key",
        "type"
      ],
      "additionalProperties": false
    },
    "LogDetail": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "boolean"
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "force": {
          "type": "boolean"
        }
      },
      "required": [
        "detail",
        "areas",
        "force"
      ],
      "additionalProperties": false
    },
    "LogFiles": {
      "type": "object",
      "properties": {
        "folder": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "bytes": {
          "type": "integer"
        }
      },
      "required": [
        "folder",
        "file",
        "count",
        "bytes"
      ],
      "additionalProperties": false
    },
    "LogRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "t": {
          "type": "number"
        },
        "level": {
          "type": "string"
        },
        "area": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        },
        "ctx": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "tb": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "t",
        "level",
        "area",
        "msg",
        "ctx",
        "tb"
      ],
      "additionalProperties": false
    },
    "LogSummary": {
      "type": "object",
      "properties": {
        "last": {
          "type": "integer"
        },
        "seen": {
          "type": "integer"
        },
        "new_errors": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        },
        "since": {
          "type": "number"
        }
      },
      "required": [
        "last",
        "seen",
        "new_errors",
        "errors",
        "warnings",
        "since"
      ],
      "additionalProperties": false
    },
    "LogsBadge": {
      "type": "object",
      "properties": {
        "new_errors": {
          "type": "integer"
        },
        "last": {
          "type": "integer"
        }
      },
      "required": [
        "new_errors",
        "last"
      ],
      "additionalProperties": false
    },
    "LogsQuery": {
      "type": "object",
      "properties": {
        "after": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "LogsResponse": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogRecord"
          }
        },
        "summary": {
          "$ref": "#/$defs/LogSummary"
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Problem"
          }
        },
        "files": {
          "$ref": "#/$defs/LogFiles"
        },
        "detail": {
          "$ref": "#/$defs/LogDetail"
        }
      },
      "required": [
        "records",
        "summary",
        "problems",
        "files",
        "detail"
      ],
      "additionalProperties": false
    },
    "LogsSeenRequest": {
      "type": "object",
      "properties": {
        "upto": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ObsLists": {
      "type": "object",
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "connected",
        "scenes",
        "inputs",
        "sources"
      ],
      "additionalProperties": false
    },
    "ObsOffline": {
      "type": "object",
      "properties": {
        "connected": {
          "const": false
        }
      },
      "required": [
        "connected"
      ],
      "additionalProperties": false,
      "description": "Sem o app rodando."
    },
    "Ok": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    "OpenRequest": {
      "type": "object",
      "properties": {
        "what": {
          "enum": [
            "log",
            "logs",
            "folder"
          ]
        }
      },
      "required": [
        "what"
      ],
      "additionalProperties": false
    },
    "PluginGroup": {
      "type": "object",
      "properties": {
        "color": {},
        "icon": {}
      },
      "required": [
        "color",
        "icon"
      ],
      "additionalProperties": false
    },
    "PluginInspect": {
      "type": "object",
      "properties": {
        "manifest": {
          "$ref": "#/$defs/PluginManifestSummary"
        },
        "actions": {
          "type": "array",
          "items": {}
        },
        "installed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "builtin_conflict": {
          "type": "boolean"
        }
      },
      "required": [
        "manifest",
        "actions",
        "installed",
        "builtin_conflict"
      ],
      "additionalProperties": false
    },
    "PluginInstalled": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "id": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/EditorSchema"
        }
      },
      "required": [
        "ok",
        "id",
        "schema"
      ],
      "additionalProperties": false
    },
    "PluginLoadError": {
      "type": "object",
      "properties": {
        "folder": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "folder",
        "error"
      ],
      "additionalProperties": false
    },
    "PluginManifestSummary": {
      "type": "object",
