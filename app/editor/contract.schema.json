    },
    "FreeBindRequest": {
      "$ref": "#/$defs/FreeBindRequest"
    },
    "FreeBindResponse": {
      "$ref": "#/$defs/FreeBindResponse"
    },
    "HistoryEntry": {
      "$ref": "#/$defs/HistoryEntry"
