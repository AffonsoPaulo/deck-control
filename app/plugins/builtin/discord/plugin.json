          "hint": "%action.vad_priority.hint%"
        }
      ]
    },
    "discord.toggle_vad": {
      "label": "%action.toggle_vad.label%",
      "short": "%action.toggle_vad.short%",
      "help": "%action.toggle_vad.help%",
      "icon": "audio-lines",
      "mirror": true,
      "fields": [
        {
          "name": "keys",
          "kind": "bind",
          "label": "%field.bind.label%",
          "required": true,
