{
  "id": "discord",
  "name": "Discord",
  "order": 2,
  "version": "1.5.0",
  "author": "D6",
  "default_locale": "en",
  "description": "%description%",
  "icon": "headphones",
  "color": "#5865f2",
  "category": "Discord",
  "entry": "plugin.py",
  "config_key": "discord",
  "default_enabled": true,
  "settings": [
    {
      "name": "mode",
      "kind": "enum",
      "style": "pills",
      "label": "%setting.mode.label%",
      "default": "keys",
      "options": [
        [
          "keys",
          "%option.mode.keys%"
        ],
        [
          "rpc",
          "%option.mode.rpc%"
        ]
      ],
      "help": "%setting.mode.help%"
    },
    {
      "name": "mute",
      "kind": "shortcut",
      "label": "%setting.mute.label%",
      "placeholder": "ctrl+shift+alt+f23",
      "default": "ctrl+shift+alt+f23",
      "help": "%setting.mute.help%",
      "when": {
        "mode": "keys"
      }
    },
    {
      "name": "deafen",
      "kind": "shortcut",
      "label": "%setting.deafen.label%",
      "placeholder": "ctrl+shift+alt+f24",
      "default": "ctrl+shift+alt+f24",
      "help": "%setting.deafen.help%",
      "when": {
        "mode": "keys"
      }
    },
    {
      "name": "client_id",
      "kind": "text",
      "label": "%setting.client_id.label%",
      "when": {
        "mode": "rpc"
      }
    },
    {
      "name": "client_secret",
      "kind": "password",
      "label": "%setting.client_secret.label%",
      "help": "%setting.client_secret.help%",
      "when": {
        "mode": "rpc"
      }
    }
  ],
  "steps": [
    {
      "text": "%step.1%",
      "when": {
        "mode": "keys"
      }
    },
    {
      "text": "%step.2%",
      "when": {
        "mode": "keys"
      }
    },
    {
      "text": "%step.3%",
      "when": {
        "mode": "keys"
      }
    },
    {
      "text": "%step.4%",
      "when": {
        "mode": "keys"
      }
    },
    {
      "text": "%step.5%",
      "when": {
        "mode": "keys"
      }
    },
    {
      "text": "%step.rpc.1%",
      "when": {
        "mode": "rpc"
      }
    },
    {
      "text": "%step.rpc.2%",
      "when": {
        "mode": "rpc"
      }
    },
    {
      "text": "%step.rpc.3%",
      "when": {
        "mode": "rpc"
      }
    },
    {
      "text": "%step.rpc.4%",
      "when": {
        "mode": "rpc"
      }
    },
    {
      "text": "%step.rpc.5%",
      "when": {
        "mode": "rpc"
      }
    },
    {
      "text": "%step.more%"
    }
  ],
  "states": [
    [
      "discord.mute",
      "%state.mute%"
    ],
    [
      "discord.deafen",
      "%state.deafen%"
    ]
  ],
  "actions": {
    "discord.mute": {
      "label": "%action.mute.label%",
      "help": "%action.mute.help%",
      "fields": [
        {
          "name": "keys",
          "kind": "text",
          "label": "%field.keys.label%",
          "help": "%field.keys.help%"
        }
      ],
      "state": true
    },
    "discord.deafen": {
      "label": "%action.deafen.label%",
      "help": "%action.deafen.help%",
      "fields": [
        {
          "name": "keys",
          "kind": "text",
          "label": "%field.keys.label%",
          "help": "%field.keys.help%"
        }
      ],
      "state": true
    },
    "discord.ptt": {
      "label": "%action.ptt.label%",
      "short": "%action.ptt.short%",
      "help": "%action.ptt.help%",
      "icon": "mic",
      "mirror": true,
      "fields": [
        {
          "name": "keys",
          "kind": "bind",
          "label": "%field.bind.label%",
          "required": true,
          "hint": "%action.ptt.hint%"
        }
      ]
    },
    "discord.ptt_priority": {
      "label": "%action.ptt_priority.label%",
      "short": "%action.ptt_priority.short%",
      "help": "%action.ptt_priority.help%",
      "icon": "megaphone",
      "mirror": true,
      "fields": [
        {
          "name": "keys",
          "kind": "bind",
          "label": "%field.bind.label%",
          "required": true,
          "hint": "%action.ptt_priority.hint%"
        }
      ]
    },
    "discord.push_to_mute": {
