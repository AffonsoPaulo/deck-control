      "short": "%action.push_to_mute.short%",
      "help": "%action.push_to_mute.help%",
      "icon": "mic-off",
      "mirror": true,
      "fields": [
        {
          "name": "keys",
          "kind": "bind",
          "label": "%field.bind.label%",
          "required": true,
          "hint": "%action.push_to_mute.hint%"
        }
      ]
    },
    "discord.vad_priority": {
      "label": "%action.vad_priority.label%",
      "short": "%action.vad_priority.short%",
      "help": "%action.vad_priority.help%",
      "icon": "speech",
      "mirror": true,
      "fields": [
