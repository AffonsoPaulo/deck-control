{
  "id": "weather",
  "name": "Clima",
  "order": 3,
  "version": "1.0.0",
  "author": "D6",
  "default_locale": "en",
  "description": "%description%",
  "icon": "cloud-sun",
  "color": "#3e8ed0",
  "category": "%category%",
  "entry": "plugin.py",
  "config_key": "weather",
  "default_enabled": false,
  "homepage": "https://open-meteo.com",
  "settings": [
    {
      "name": "city",
      "kind": "text",
      "label": "%setting.city.label%",
      "placeholder": "São Paulo",
      "default": "",
      "help": "%setting.city.help%"
    },
    {
      "name": "refresh",
      "kind": "number",
      "label": "%setting.refresh.label%",
      "placeholder": "15",
      "default": 15,
      "half": true,
      "help": "%setting.refresh.help%"
    }
  ],
  "steps": [
    {
      "text": "%step.1%"
    },
    {
      "text": "%step.2%"
    },
    {
      "text": "%step.3%"
    }
  ],
  "actions": {},
  "values": [
    {
      "id": "weather.temp",
      "label": "%value.temp%",
      "kind": "number",
      "sample": 28
    },
    {
      "id": "weather.max",
      "label": "%value.max%",
      "kind": "number",
      "sample": 31
    },
    {
      "id": "weather.min",
      "label": "%value.min%",
      "kind": "number",
      "sample": 19
    },
    {
      "id": "weather.condition",
      "label": "%value.condition%",
      "kind": "text",
      "sample": "%sample.condition%"
    },
    {
      "id": "weather.icon",
      "label": "%value.icon%",
      "kind": "icon",
      "sample": "cloud-sun"
    },
    {
      "id": "weather.wind",
      "label": "%value.wind%",
      "kind": "number",
      "sample": 12
    },
    {
      "id": "weather.rain",
      "label": "%value.rain%",
      "kind": "number",
      "sample": 40
    },
    {
      "id": "weather.humidity",
      "label": "%value.humidity%",
      "kind": "number",
      "sample": 65
    },
    {
      "id": "weather.city",
      "label": "%value.city%",
      "kind": "text",
      "sample": "São Paulo"
    },
    {
      "id": "weather.d1.name",
      "label": "%value.d1.name%",
      "kind": "text",
      "sample": "%sample.d1.name%"
    },
    {
      "id": "weather.d1.max",
      "label": "%value.d1.max%",
      "kind": "number",
      "sample": 30
    },
    {
      "id": "weather.d1.min",
      "label": "%value.d1.min%",
      "kind": "number",
      "sample": 20
    },
    {
      "id": "weather.d1.icon",
      "label": "%value.d1.icon%",
      "kind": "icon",
      "sample": "cloud-rain"
    },
    {
      "id": "weather.d2.name",
      "label": "%value.d2.name%",
      "kind": "text",
      "sample": "%sample.d2.name%"
