    {
      "id": "weather.d2.max",
      "label": "%value.d2.max%",
      "kind": "number",
      "sample": 27
    },
    {
      "id": "weather.d2.min",
      "label": "%value.d2.min%",
      "kind": "number",
      "sample": 18
    },
    {
      "id": "weather.d2.icon",
      "label": "%value.d2.icon%",
      "kind": "icon",
      "sample": "cloud"
    },
    {
      "id": "weather.d3.name",
      "label": "%value.d3.name%",
      "kind": "text",
      "sample": "%sample.d3.name%"
