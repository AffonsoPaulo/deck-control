        }
      ],
      "sizes": {
        "1x1": [
          [
            {
              "lucide": "{weather.icon}",
              "text": "{weather.temp}°",
              "bg": "#1f3a5f",
              "fg": "#ffffff"
            }
          ]
        ],
        "1x2": [
