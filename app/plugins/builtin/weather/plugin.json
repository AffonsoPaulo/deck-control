    {
      "id": "weather.d3.max",
      "label": "%value.d3.max%",
      "kind": "number",
      "sample": 29
    },
    {
      "id": "weather.d3.min",
      "label": "%value.d3.min%",
      "kind": "number",
      "sample": 19
    },
    {
      "id": "weather.d3.icon",
      "label": "%value.d3.icon%",
      "kind": "icon",
      "sample": "sun"
    }
