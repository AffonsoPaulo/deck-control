{
  "name": "deck-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Editor do Deck em React (substitui app/editor/static quando cobrir tudo).",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "preview": "vite preview",
    "ref:capture": "playwright test tests/reference",
    "check": "npm run lint && npm run typecheck && npm run check:api && npm run test",
    "test": "vitest run",
    "check:icons": "node scripts/check-icons.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.7.1",
    "immer": "11.2.9",
    "lucide-react": "1.66.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-error-boundary": "6.1.6",
    "react-hotkeys-hook": "5.3.3",
    "react-i18next": "17.1.11",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
